# -----------------------
# Database
# -----------------------
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_PORT=5432

# For backend running on host (bare metal):
# Example: postgresql+psycopg://appuser:apppass@localhost:5432/appdb
DATABASE_URL_HOST=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# For backend running inside docker (service name "postgres"):
# Example: postgresql+psycopg://appuser:apppass@postgres:5432/appdb
DATABASE_URL_DOCKER=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# -----------------------
# Backend
# -----------------------
BACKEND_PORT=8000
STORAGE_PATH=/data/uploads
# FirebaseAuth configuration
# -----------------------
# Firebase Authentication
# -----------------------
FIREBASE_PROJECT_ID=your_project_id

# Firebase Admin SDK credentials
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# Optional: JSON inline alternative
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Web SDK (frontend)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional
FIREBASE_DATABASE_URL=

# -----------------------
# Firebase Cloud Messaging
# -----------------------
FCM_ENABLED=true

# optional default topic
FCM_DEFAULT_TOPIC=all-users

# push retry count
FCM_MAX_RETRIES=3

# -----------------------
# Dev Hosting - Tunnels without exposing local IP (optional)
# -----------------------
# Dev tunnel - localtunnel
# no token required, but can be flaky and may require multiple attempts to connect
# -----------------------
# Dev tunnel - LocalXpose: alternative to localtunnel if it keeps failing
# rquired: sign up for a free account at https://localxpose.io/ and get your token
# -----------------------
# Put your LocalXpose token here
# LX_TOKEN=REPLACE_ME # uncomment and set this if you want to use LocalXpose instead of localtunnel
