meta {
  name: Generate Fiche
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/documents/generate-fiche
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "template": "ete",
    "data": {
      "student_name": "Bruno Tester",
      "company_name": "Test Company",
      "title": "Amazing Internship"
    }
  }
}

vars:pre-request {
  baseUrl: http://localhost:8000
  token: test-bruno-user
}
