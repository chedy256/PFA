meta {
  name: Admin Bootstrap
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/bootstrap
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "first_name": "Admin",
    "last_name": "User",
    "requested_role": "admin"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8000
  token: test-bruno-admin
}
