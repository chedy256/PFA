meta {
  name: Register Device
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/devices
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "platform": "web",
    "web_subscription": {
      "endpoint": "https://test.com",
      "keys": {
        "auth": "xyz",
        "p256dh": "abc"
      }
    }
  }
}

vars:pre-request {
  baseUrl: http://localhost:8000
  token: test-bruno-user
}
