meta {
  name: Create Teacher (Admin)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/admin/teachers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "first_name": "New",
    "last_name": "Teacher",
    "email": "teacher1@example.com"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8000
  token: test-bruno-admin
}
